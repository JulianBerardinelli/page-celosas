---
interface Props {
  title: string;
  description?: string;
  image: string;
  href: string;
  buttonText?: string;
  class?: string;
}

const {
  title,
  description,
  image,
  href,
  buttonText = "Ver productos",
  class: extraClass = "",
} = Astro.props;
---

<a
  href={href}
  class={`group w-full bg-white rounded-xl overflow-hidden shadow-md transition duration-300 hover:shadow-xl hover:scale-[1.02] ${extraClass} sm:max-w-xs h-full flex flex-col`}
>
  <!-- Imagen fija -->
  <div class="w-full h-48 overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <!-- Contenido -->
  <div class="flex flex-col flex-grow justify-between text-center px-4 py-6">
    <div>
      <h3 class="text-xl font-bold mb-2 text-primary">{title}</h3>
      {description && (
        <p class="text-sm mb-4 text-gray-600">
          {description}
        </p>
      )}
    </div>

    <!-- Botón con ancho fijo -->
    <span
      class="inline-block w-fit px-4 py-2 border border-accent text-accent rounded-full text-sm font-semibold transition-all duration-300 hover:bg-accent hover:text-white mx-auto"
    >
      {buttonText}
    </span>
  </div>
</a>



