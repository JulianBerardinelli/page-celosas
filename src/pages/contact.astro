---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import GlobalSupport from '~/components/widgets/GlobalSupport.astro';

const metadata = {
  title: 'Contacto',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="" title="Contacto" />

  <ContactUs
  action='https://formspree.io/f/xblkkzjj'
    id="form"
    title="¡Escribinos!"
    subtitle="Si buscás una respuesta rápida, podés visitar nuestra sección de Preguntas Frecuentes. Si no encontrás lo que necesitás, nuestro equipo de atención estará encantado de ayudarte."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nombre',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Correo electrónico',
      },
    ]}
    textarea={{
      label: 'Mensaje',
    }}
    disclaimer={{
      label:
        'Al enviar este formulario, aceptás el tratamiento de tus datos personales de acuerdo con nuestra política de privacidad.',
    }}
    description="Nuestro equipo suele responder dentro de las 24 horas hábiles."
  />

  <!-- Features2 Widget ************** -->

  <GlobalSupport />
</Layout>
