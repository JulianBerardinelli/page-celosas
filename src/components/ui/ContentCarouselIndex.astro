---
// ContentCarouselIndex.astro
import Carousel from './Carousel.astro';
---

<Carousel>
  <!-- Slide 1: VIDEO -->
  <div class="carousel-slide relative">
    <video
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 w-full h-full object-cover -z-10"
    >
      <source src="/videos/galletitas-spot.mp4" type="video/mp4" />
      Tu navegador no soporta videos HTML5.
    </video>
  </div>

  <!-- Slide 2 -->
  <div class="carousel-slide relative">
    <picture>
      <img src="/images/car-1.jpg" alt="Sabores de repostería" class="absolute inset-0 w-full h-full object-cover -z-10" />
    </picture>
  </div>
</Carousel>
